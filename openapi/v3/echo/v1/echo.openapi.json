{
    "openapi": "3.0.0",
    "info": {
        "title": "Echo",
        "version": "0.0.1",
        "contact": {
            "name": "kanziw",
            "url": "https://github.com/kanziw/grpc-node-playground",
            "email": "kanziwoong@gmail.com"
        }
    },
    "tags": [
        {
            "name": "EchoService"
        }
    ],
    "paths": {
        "/echo": {
            "get": {
                "operationId": "EchoService_Echo",
                "responses": {
                    "200": {
                        "description": "A successful response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1EchoResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1ErrorMessage"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "An unexpected error response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/rpcStatus"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "message",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "EchoService"
                ]
            }
        },
        "/v1/echo/{message}": {
            "get": {
                "operationId": "EchoService_Echo2",
                "responses": {
                    "200": {
                        "description": "A successful response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1EchoResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1ErrorMessage"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "An unexpected error response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/rpcStatus"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "message",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "EchoService"
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "protobufAny": {
                "type": "object",
                "properties": {
                    "@type": {
                        "type": "string"
                    }
                },
                "additionalProperties": {}
            },
            "rpcStatus": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    },
                    "details": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/protobufAny"
                        }
                    }
                }
            },
            "v1ChatResponse": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "responseTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "v1Code": {
                "type": "string",
                "enum": [
                    "CODE_UNSPECIFIED",
                    "CODE_FAKE_ERROR"
                ],
                "default": "CODE_UNSPECIFIED"
            },
            "v1EchoResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "responseTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "v1EchoStreamResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "sequenceNumber": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "responseTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "v1ErrorMessage": {
                "type": "object",
                "properties": {
                    "code": {
                        "$ref": "#/components/schemas/v1Code"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "v1StreamEchoResponse": {
                "type": "object",
                "properties": {
                    "fullMessage": {
                        "type": "string"
                    },
                    "responseTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}